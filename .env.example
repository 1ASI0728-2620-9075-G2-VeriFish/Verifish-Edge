# ===================================================
# YAKU-EDGE CONFIGURATION (.env)
# ===================================================

# --- MQTT Broker Configuration ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=yaku/telemetria/pond/#

# --- Redis In-Memory Queue ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_QUEUE=telemetry_queue

# --- Backend API Target (Nube o Monolito Local) ---
API_URL=http://localhost:8080/api/v1/telemetry/manual-ingest

# --- Firma HMAC de las lecturas (el backend valida X-Farm-Id / X-Signature) ---
# FARM_ID: id numérico de la granja (GET /api/v1/farms)
# FARM_TOKEN: farmToken (UUID) de esa granja; es la clave HMAC
FARM_ID=1
FARM_TOKEN=cambiar-por-el-farm-token-real
